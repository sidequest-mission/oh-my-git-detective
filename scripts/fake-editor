#!/usr/bin/env perl

use strict;
use warnings;
use IO::Socket::INET;

my $port = $ENV{OH_MY_GIT_EDITOR_PORT};
die "Oh My Git editor has no listening port\n" unless $port && $port =~ /^\d+$/;
my $path = $ARGV[0] // die "No file was given to the Oh My Git editor\n";

open my $input, '<:raw', $path or die "Cannot read $path: $!\n";
my $content = do { local $/; <$input> } // '';
close $input;

my $socket = IO::Socket::INET->new(
    PeerAddr => '127.0.0.1',
    PeerPort => $port,
    Proto    => 'tcp',
) or die "Cannot connect to the Oh My Git editor: $!\n";
binmode $socket, ':raw';
$socket->autoflush(1);
# Git also uses this editor for rebase instructions and ordinary files.
my $is_commit = $path =~ m{(?:^|[/\\])COMMIT_EDITMSG\z} ? 1 : 0;
print {$socket} pack('CV', $is_commit, length($content)), $content
    or die "Cannot send the file to the Oh My Git editor: $!\n";

my $header = read_exact($socket, 4);
exit 1 unless defined $header;  # Closing the editor cancels the Git operation.
my $result = read_exact($socket, unpack('V', $header));
die "Incomplete response from the Oh My Git editor\n" unless defined $result;

open my $output, '>:raw', $path or die "Cannot write $path: $!\n";
print {$output} $result or die "Cannot write $path: $!\n";
close $output or die "Cannot close $path: $!\n";

sub read_exact {
    my ($stream, $length) = @_;
    my $bytes = '';
    while (length($bytes) < $length) {
        my $read = read($stream, $bytes, $length - length($bytes), length($bytes));
        die "Cannot read from the Oh My Git editor: $!\n" unless defined $read;
        return undef if $read == 0;
    }
    return $bytes;
}
