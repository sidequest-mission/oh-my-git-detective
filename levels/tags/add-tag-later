echo "event 3" >> feature-list

git add .
git commit -m "Adding feature 3"

git checkout --detach main
git rev-parse HEAD^ > .git/v1-target

[win]

# Did you create a new tag?
test "$(git rev-parse --verify refs/tags/v1^{commit})" = "$(cat .git/v1-target)"

