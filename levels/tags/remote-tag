[win]
# v1 tag in your repo
test "$(git rev-parse --verify refs/tags/v1^{commit})" = "$(cat .git/v1-target)"

# v2 tag in your repo
test "$(git rev-parse --verify refs/tags/v2^{commit})" = "$(cat .git/v2-target)"


[win friend]

# v2 tag in the remote
test "$(git rev-parse --verify refs/tags/v2^{commit})" = "$(cat .git/v2-target)"
